{
  "name": "claude-cli-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAI Chat Completions compatible bridge to the locally authenticated Claude Code CLI",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "doctor": "node scripts/doctor.js",
    "config": "node scripts/config.js",
    "models": "node scripts/models.js",
    "models:check": "node scripts/check-historical-models.js",
    "smoke": "node scripts/smoke.js",
    "smoke:thinking": "node scripts/smoke-thinking.js"
  }
}
