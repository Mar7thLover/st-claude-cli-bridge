# 日常配置请直接编辑 config.json（带字段说明和校验）。
# 本文件仅用于临时覆盖：复制为 .env 后取消注释需要的行，这里的值优先于 config.json。
# 留空的变量视为未设置。修改后重启桥接器。
# BRIDGE_CONFIG=config.json
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8788
# BRIDGE_API_KEY=
# BRIDGE_MAX_CONCURRENT=2
# BRIDGE_MAX_BODY_BYTES=8388608
# CLAUDE_BIN=
# CLAUDE_MODEL=sonnet
# BRIDGE_MODELS=sonnet,opus,haiku
