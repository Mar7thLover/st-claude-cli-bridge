{
  "$schema": "./config.schema.json",
  "server": {
    "host": "127.0.0.1",
    "port": 8788,
    "apiKey": "",
    "maxConcurrent": 2,
    "maxBodyBytes": 8388608,
    "allowedOrigins": [],
    "heartbeatSeconds": 10,
    "retryAfterSeconds": 3,
    "logRequests": true
  },
  "claude": {
    "bin": "",
    "defaultModel": "sonnet",
    "extraModels": [
      "sonnet",
      "opus",
      "haiku"
    ],
    "discoveryTimeoutSeconds": 15,
    "modelCheckMaxAgeHours": 24,
    "thinkingDisplay": "summarized"
  }
}
